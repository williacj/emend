{
  "name": "emend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "node scripts/rust-launcher.mjs tauri",
    "tauri:shared": "node scripts/rust-launcher.mjs --shared tauri",
    "build:rust": "node scripts/rust-launcher.mjs cargo build --package cowrite",
    "build:rust:shared": "node scripts/rust-launcher.mjs --shared cargo build --package cowrite",
    "matrix:check": "node scripts/check-test-matrix.mjs",
    "scope:tests": "node scripts/scope-tests.mjs",
    "check:vitest-unhandled-errors": "node scripts/check-vitest-unhandled-errors.mjs",
    "check:repo-skills": "node scripts/repo-skill-alias.mjs --check",
    "repair:repo-skills": "node scripts/repo-skill-alias.mjs --repair",
    "pretest": "tsc --noEmit",
    "test": "vitest run",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:scripts": "cd scripts && node --test",
    "test:scripts:ci": "npm run test:scripts -- --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./node-test-results-reporter.mjs --test-reporter-destination=stdout",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --grep-invert @quarantine"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "lucide-react": "^1.28.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
