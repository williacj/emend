<?xml version="1.0" encoding="UTF-16"?>
<!-- ABOUTME: Task Scheduler recipe owning the sccache server on a self-hosted Windows runner -->
<!-- ABOUTME: host (#1178). __USER__ is this file's only placeholder; the launcher has two more. -->
<!-- The task, not any CI job, owns the daemon: a job-spawned server is reaped when that job -->
<!-- completes and takes the concurrent job's compile down with it. See docs/ci-windows-runner.md -->
<!-- "Externally-owned compiler cache" and scripts/sccache-server.cmd. -->
<!-- __USER__ MUST be the runner services' own account — the StartName of that host's actions.runner -->
<!-- services. That may be the operator's own account or a DEDICATED service account; both are in -->
<!-- use across this pool, and which one it is drives the launcher's substitutions too. -->
<!-- The <Command> below is the INSTALLED launcher path, outside any checkout by design; the repo -->
<!-- copy of that script is the template it is copied from, not the file this runs. It is the same -->
<!-- path on every host, so it needs no substitution. -->
<!-- SUBSTITUTING __USER__ IS NOT ENOUGH (corrected 2026-08-23; #1900 claimed it was). The launcher -->
<!-- carries __SCCACHE_EXE__ and __SCCACHE_DIR__, because resolving either through %USERPROFILE%/ -->
<!-- %LOCALAPPDATA% assumes the service account owns a profile with a .cargo directory — false for a -->
<!-- dedicated service account, where it yields a missing binary and no daemon. Substitute all three. -->
<!-- The task account must still be the one that can execute the substituted __SCCACHE_EXE__. -->
<!-- Registration REQUIRES elevation: the BootTrigger makes the task admin-only, and an unelevated -->
<!-- Register-ScheduledTask returns "Access is denied". -->
<!-- This template is committed as plain UTF-8 for readable diffs; `encoding="UTF-16"` above -->
<!-- describes the file `schtasks /Create /XML` requires — it rejects UTF-8, so re-encode with -->
<!-- `Set-Content -Encoding Unicode` if you install that way. The ScheduledTasks cmdlets -->
<!-- (Register-ScheduledTask) sidestep the encoding trap entirely and are what was used on -->
<!-- WILLIACJ-01; Windows exports the registered task as UTF-16LE either way. -->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>sccache server for the Cowrite self-hosted Windows CI runners — owned by this task rather than by a CI job, so no job's end-of-run process cleanup can kill a build in flight (#1178). Runs whether logged on or not (BootTrigger + S4U logon) and never self-terminates on the 72h default (ExecutionTimeLimit disabled). RestartOnFailure covers a crash only: it fires on a non-zero exit, so a clean `sccache --stop-server` (rc=0) leaves the server down with no NextRunTime until reboot or `schtasks /Run /TN sccache-server`. The workflow's preflight is what stops that being silent.</Description>
  </RegistrationInfo>
  <Triggers>
    <BootTrigger>
      <Enabled>true</Enabled>
    </BootTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>__USER__</UserId>
      <LogonType>S4U</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>999</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\sccache\start-sccache-server.cmd</Command>
    </Exec>
  </Actions>
</Task>
