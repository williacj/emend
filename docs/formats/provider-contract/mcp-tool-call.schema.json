{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emend.local/formats/provider-contract/mcp-tool-call.schema.json",
  "schema_version": 1,
  "title": "Emend MCP tool call",
  "description": "A call to one of the Emend-hosted MCP tools (TD-1 §3.2 tool surface, v1). Shape = `{name, arguments}` — the JSON-RPC `tools/call` params. `arguments` is validated per-tool via the `name` discriminator. Argument shapes are derived from the TD-1 §3.2 design contract; the tool-*call*/*result* stream-event framing was not exercised in SPIKE-1 (gap #7) and is captured during adapter work — this schema constrains the argument payloads the agent sends. Protection (D21) and revision-token staleness (TD-7) are enforced by the tool implementation, not this schema. Unknown tool names are rejected.",
  "type": "object",
  "required": ["name", "arguments"],
  "properties": {
    "name": {
      "enum": [
        "get_document_state",
        "propose_changes",
        "add_comments",
        "reply_to_comment",
        "create_document",
        "list_documents",
        "permission_request"
      ]
    },
    "arguments": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "required": ["name"], "properties": { "name": { "const": "get_document_state" } } },
      "then": { "properties": { "arguments": { "$ref": "#/$defs/getDocumentStateArgs" } } }
    },
    {
      "if": { "required": ["name"], "properties": { "name": { "const": "propose_changes" } } },
      "then": { "properties": { "arguments": { "$ref": "#/$defs/proposeChangesArgs" } } }
    },
    {
      "if": { "required": ["name"], "properties": { "name": { "const": "add_comments" } } },
      "then": { "properties": { "arguments": { "$ref": "#/$defs/addCommentsArgs" } } }
    },
    {
      "if": { "required": ["name"], "properties": { "name": { "const": "reply_to_comment" } } },
      "then": { "properties": { "arguments": { "$ref": "#/$defs/replyToCommentArgs" } } }
    },
    {
      "if": { "required": ["name"], "properties": { "name": { "const": "create_document" } } },
      "then": { "properties": { "arguments": { "$ref": "#/$defs/createDocumentArgs" } } }
    },
    {
      "if": { "required": ["name"], "properties": { "name": { "const": "list_documents" } } },
      "then": { "properties": { "arguments": { "$ref": "#/$defs/listDocumentsArgs" } } }
    },
    {
      "if": { "required": ["name"], "properties": { "name": { "const": "permission_request" } } },
      "then": { "properties": { "arguments": { "$ref": "#/$defs/permissionRequestArgs" } } }
    }
  ],
  "$defs": {
    "anchor": {
      "$comment": "Shared anchor shape (TD-4/TD-6): raw-file offsets + context, no line/col. `text_snapshot` is required (TD-14): without it, a drifted-but-in-bounds offset is indistinguishable from a verified one.",
      "type": "object",
      "required": ["offset", "length", "text_snapshot"],
      "properties": {
        "offset": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 0 },
        "text_snapshot": { "type": "string" },
        "context_before": { "type": "string" },
        "context_after": { "type": "string" }
      }
    },
    "getDocumentStateArgs": {
      "type": "object",
      "required": ["doc"],
      "properties": { "doc": { "type": "string" } },
      "additionalProperties": false
    },
    "proposeChangesArgs": {
      "type": "object",
      "required": ["doc", "revision", "edits", "summary"],
      "properties": {
        "doc": { "type": "string" },
        "revision": { "type": "string" },
        "edits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["range", "replacement"],
            "properties": {
              "range": {
                "type": "object",
                "required": ["offset", "length"],
                "properties": {
                  "offset": { "type": "integer", "minimum": 0 },
                  "length": { "type": "integer", "minimum": 0 }
                }
              },
              "replacement": { "type": "string" },
              "note": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "summary": { "type": "string" },
        "change_set_meta": { "type": "object" }
      },
      "additionalProperties": false
    },
    "addCommentsArgs": {
      "type": "object",
      "required": ["doc", "comments"],
      "properties": {
        "doc": { "type": "string" },
        "comments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "$comment": "`anchor` is omitted for a document-level finding/comment (FR-REVIEW-2) — required is `body` only.",
            "required": ["body"],
            "properties": {
              "anchor": { "$ref": "#/$defs/anchor" },
              "body": { "type": "string" },
              "severity": { "type": "string" },
              "skill": { "type": "string" },
              "workflow_run": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "replyToCommentArgs": {
      "type": "object",
      "required": ["comment_id", "body", "kind"],
      "properties": {
        "comment_id": { "type": "string" },
        "body": { "type": "string" },
        "kind": { "enum": ["reply", "defense"] }
      },
      "additionalProperties": false
    },
    "createDocumentArgs": {
      "type": "object",
      "required": ["path", "content"],
      "properties": {
        "path": { "type": "string" },
        "content": { "type": "string" }
      },
      "additionalProperties": false
    },
    "listDocumentsArgs": {
      "type": "object",
      "additionalProperties": false
    },
    "permissionRequestArgs": {
      "type": "object",
      "required": ["action", "detail", "why"],
      "properties": {
        "action": { "type": "string" },
        "detail": { "type": "string" },
        "why": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
