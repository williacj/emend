{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "1800000",
    "BASH_MAX_TIMEOUT_MS": "1800000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "timeout": 10,
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/refuse-reserved-git-commands.mjs\" || { code=$?; [ \"$code\" -eq 2 ] || printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"The command gate did not run, so it refused rather than let the command through.\"}}'; exit 2; }"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(cargo test:*)",
      "Bash(cargo build:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr edit * --body-file *)",
      "Edit(./**)"
    ],
    "deny": [
      "Bash(git commit --no-verify:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --delete:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch --delete:*)",
      "Bash(*pr edit* --base *)",
      "Bash(*pr edit* -B *)",
      "Bash(*pr edit* --title *)",
      "Bash(*pr edit* -t *)",
      "Bash(*pr edit* --body *)",
      "Bash(*pr edit* -b *)",
      "Bash(*pr edit* --milestone *)",
      "Bash(*pr edit* -m *)",
      "Bash(*pr edit*--remove-milestone*)",
      "Bash(*pr edit* --add-label *)",
      "Bash(*pr edit* --remove-label *)",
      "Bash(*pr edit* --add-reviewer *)",
      "Bash(*pr edit* --remove-reviewer *)",
      "Bash(*pr edit* --add-assignee *)",
      "Bash(*pr edit* --remove-assignee *)",
      "Bash(*pr edit* --add-project *)",
      "Bash(*pr edit* --remove-project *)",
      "Bash(*pr edit* --attach *)",
      "Bash(*pr edit* --repo *)",
      "Bash(*pr edit* -R *)"
    ]
  }
}
